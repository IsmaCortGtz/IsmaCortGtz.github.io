---
import type { Project, UIContent } from "@/interfaces/Content";
import ProjectCover from "./ProjectCover.astro";

interface Props {
  project: Project;
  ui: UIContent;
  lang: string;
}

const { project, ui, lang } = Astro.props;
const status = project.status ?? "completed";
const statusLabel = ui.status[status] ?? status;
const githubTreeUrl = `https://github.com/${project.github.user}/${project.github.repository}/tree/${project.github.branch}`;
---

<section class="project-details-card">
  <div class="project-cover-container" transition:name={`project-cover-${project.id}`}>
    <ProjectCover class="project-cover" title={project.title} subtitle={project.subtitle} />
  </div>
  <h4
    class="project-details-title"
    transition:name={`project-title-${project.id}`}
    set:html={project.title}
  />
  <h6 class="project-details-subtitle" set:html={project.subtitle} />
  <span class={`project-details-status ${status}`}>{statusLabel}</span>

  <div class="project-details-buttons">
    <a
      class="project-details-button"
      href={githubTreeUrl}
      target="_blank"
      rel="noopener noreferrer"
      title="Ver en Github"
    >
      <i class="devicon-github-original"></i>
      {ui.view_github}
    </a>
  </div>

  <div class="project-details-tags">
    {project.skills?.map((tag) => (
      <a href={`/${lang}/skill/${tag}`} class="project-details-tag" set:html={tag} />
    ))}
  </div>

  <p class="project-details-description" set:html={project.description} />
</section>

<style>
  .project-details-card {
    background-color: color-mix(in oklab, var(--color-brand-box) 50%, transparent);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 4rem;
    gap: 1rem;
    display: grid;
    grid-template:
      "cover title" auto
      "cover subtitle" auto
      "cover state" auto
      "cover buttons" auto
      "tags tags" auto
      "description description" auto;
  }

  .project-cover-container {
    grid-area: cover;
    width: 100%;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.project-cover) {
    border-radius: 0.5rem;
    width: 100%;
    margin: auto;
  }

  .project-details-title {
    grid-area: title;
    font-size: 1.5rem;
    width: fit-content;
    margin: 0;
  }

  .project-details-subtitle {
    grid-area: subtitle;
    color: color-mix(in oklab, var(--color-brand-text) 70%, transparent);
    font-size: 1rem;
    font-style: italic;
    margin: 0;
  }

  .project-details-status {
    background-color: var(--color-brand-yellow, #ddba2c);
    color: color-mix(in oklab, var(--color-brand-yellow, #ddba2c) 60%, black);
    width: fit-content;
    padding: 0.6rem;
    border-radius: 0.4rem;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: help;
    user-select: none;
    border: 0.1rem solid color-mix(in oklab, var(--color-brand-yellow, #ddba2c) 100%, black 30%);
  }

  .project-details-status.completed {
    background-color: var(--color-brand-green, #4caf50);
    color: color-mix(in oklab, var(--color-brand-green, #4caf50) 60%, black);
    border-color: color-mix(in srgb, var(--color-brand-green, #4caf50) 100%, black 30%);
  }

  .project-details-buttons {
    grid-area: buttons;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-details-button {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    background-color: color-mix(in oklab, var(--color-brand-light) 70%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-brand-light) 100%, white 5%);
    color: var(--color-brand-text);
    text-decoration: none;
    border-radius: 0.5rem;
    padding: 0.5rem;
    font-size: 0.9rem;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
    user-select: none;
  }

  .project-details-button:hover {
    background-color: color-mix(in oklab, var(--color-brand-light) 100%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-brand-light) 100%, white 40%);
    transform: scale(1.05);
  }

  .project-details-button > i {
    font-size: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .project-details-tags {
    grid-area: tags;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-details-tag {
    text-decoration: none;
    border: 1px solid color-mix(in oklab, var(--color-brand-light) 25%, transparent);
    background-color: color-mix(in oklab, var(--color-brand-light) 25%, transparent);
    color: color-mix(in oklab, var(--color-brand-light) 70%, white);
    border-radius: 0.5rem;
    padding: 0.5rem;
    font-size: 0.8rem;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
    user-select: none;
  }

  .project-details-tag:hover {
    transform: scale(1.05);
    border: 1px solid color-mix(in oklab, var(--color-brand-light) 40%, white 20%);
    background-color: color-mix(in oklab, var(--color-brand-light) 40%, white 5%);
  }

  .project-details-description {
    grid-area: description;
    color: color-mix(in oklab, var(--color-brand-text) 50%, transparent);
    line-height: 1.5;
    font-size: 1rem;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .project-details-card {
      grid-template:
        "cover" auto
        "title" auto
        "subtitle" auto
        "state" auto
        "tags" auto
        "description" auto
        "buttons" auto;
    }
  }
</style>
