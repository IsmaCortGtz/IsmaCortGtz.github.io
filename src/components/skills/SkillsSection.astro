---
import type { Skills } from "@/interfaces/Content";
import SkillCard from "./SkillCard.astro";

interface Props {
  skills: Skills;
  lang: string;
  title: string;
}

const { skills, lang, title } = Astro.props;
---

<section>
  <h2 id="skills" class="mt-16 mb-8 text-3xl flex items-center gap-2">
    <i class="ti ti-shield-filled"></i>
    {title}
  </h2>

  {Object.entries(skills).map(([category, cards]) => (
    <div class="mb-14">
      <h3 class="text-xl mb-4" set:html={category} />
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-5">
        {Object.entries(cards).map(([skillName, icon]) => (
          <SkillCard name={skillName} icon={icon} lang={lang} />
        ))}
      </div>
    </div>
  ))}
</section>
