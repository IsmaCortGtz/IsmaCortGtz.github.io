---
import type { UIContent } from "@/interfaces/Content";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  ui: Pick<UIContent, "projects" | "skills">;
  lang?: string;
}

const { ui, lang } = Astro.props;
---

<header
  transition:name="site-header"
  class="sticky top-2 z-50 border border-brand-light/20 mx-auto w-[92%] max-w-sm rounded-full bg-brand-hd flex flex-row items-center justify-between px-3 h-11 shadow-lg shadow-black/20"
>
  <nav class="flex flex-row gap-1 items-center">
    <a
      href="#projects"
      class="py-1.5 px-3 hover:bg-brand-box/50 rounded-full cursor-pointer transition-colors duration-200 text-sm"
    >
      {ui.projects}
    </a>
    <a
      href="#skills"
      class="py-1.5 px-3 hover:bg-brand-box/50 rounded-full cursor-pointer transition-colors duration-200 text-sm"
    >
      {ui.skills}
    </a>
  </nav>

  <div class="flex items-center pl-2 border-l border-brand-light/20">
    <LanguageSwitcher currentLang={lang} />
  </div>
</header>
