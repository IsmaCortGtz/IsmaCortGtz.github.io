---
import type { UIContent } from "@/interfaces/Content";

interface Props {
  ui: Pick<UIContent, "projects" | "skills">;
}

const { ui } = Astro.props;
---

<header
  transition:name="site-header"
  class="sticky top-2 z-50 border border-brand-light/20 mx-auto w-[90%] max-w-xs rounded-full bg-brand-hd flex flex-row gap-4 items-center justify-center h-11"
>
  <a
    href="#projects"
    class="py-1.5 px-4 hover:bg-brand-box/50 rounded-full cursor-pointer transition-colors duration-200"
  >
    {ui.projects}
  </a>
  <a
    href="#skills"
    class="py-1.5 px-4 hover:bg-brand-box/50 rounded-full cursor-pointer transition-colors duration-200"
  >
    {ui.skills}
  </a>
</header>
