---
import type { UIContent } from "@/interfaces/Content";

interface Props {
  ui: Pick<UIContent, "projects" | "skills">;
}

const { ui } = Astro.props;
---

<header class="sticky top-2 z-50 border-2 mx-auto w-11/12 max-w-xs rounded-full border-brand-light/20 bg-brand-hd flex flex-row gap-4 items-center justify-center">
  <a href="#projects" class="py-2 px-4 hover:bg-brand-box/50 rounded-full cursor-pointer transition-all">
    {ui.projects}
  </a>
  <a href="#skills" class="py-2 px-4 hover:bg-brand-box/50 rounded-full cursor-pointer transition-all">
    {ui.skills}
  </a>
</header>
