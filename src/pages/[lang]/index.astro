---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/common/Header.astro";
import ProfileSection from "@/components/profile/ProfileSection.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import SkillsSection from "@/components/skills/SkillsSection.astro";
import { loadProfile, loadSkills, loadUI } from "@/services/content";
import { loadProjects } from "@/services/projects";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

const { lang = "en" } = Astro.params;

const [profile, skills, projects, ui] = await Promise.all([
  loadProfile(lang),
  loadSkills(lang),
  loadProjects(lang),
  loadUI(lang),
]);
---

<Layout title={profile.title} description={profile.description}>
  <Header ui={ui} lang={lang} />
  <main class="w-full max-w-4xl mx-auto flex flex-col px-4 md:px-2 pt-20 pb-16">
    <ProfileSection profile={profile} />

    <section>
      <h2 id="projects" class="mt-16 mb-8 text-3xl flex items-center gap-2">
        <i class="ti ti-settings-filled"></i>
        {ui.projects}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </section>

    <SkillsSection skills={skills} lang={lang} title={ui.skills} />
  </main>
</Layout>
