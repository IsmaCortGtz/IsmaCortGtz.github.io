---
import Layout from "@/layouts/Layout.astro";
import BackButtonHeader from "@/components/common/BackButtonHeader.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getSkillsStaticPaths, loadProjectsBySkill, loadSkillIcon } from "@/services/skills";
import { loadUI } from "@/services/content";

export async function getStaticPaths() {
  return getSkillsStaticPaths();
}

const { lang, name } = Astro.params;
if (!lang || !name) {
  throw new Error("Language and skill name are required");
}

const [ui, skillIcon, projects] = await Promise.all([
  loadUI(lang),
  loadSkillIcon(name, lang),
  loadProjectsBySkill(name, lang),
]);
---

<Layout title={name}>
  <BackButtonHeader label={ui.go_back} fallbackUrl={`/${lang}`} />
  <main class="w-full max-w-4xl mx-auto flex flex-col px-4 md:px-2 pt-10 pb-16">
    <section
      transition:name={`skill-animation-${name}`}
      title={name}
      aria-label={name}
      class="flex flex-row items-center justify-center w-full gap-4 bg-brand-box/50 p-3 rounded-lg border border-brand-box/20"
    >
      {skillIcon && <img class="w-18 rounded-lg" src={skillIcon} alt={name} />}
      <span set:html={name} class="text-2xl font-bold" />
    </section>

    <h2 id="projects" class="my-8 pb-4 border-b-2 border-b-brand-box/80 text-3xl flex items-center gap-2">
      <i class="ti ti-settings-filled"></i>
      {ui.projects}
    </h2>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </section>
  </main>
</Layout>
