---
import Layout from "@/layouts/Layout.astro";
import BackButtonHeader from "@/components/common/BackButtonHeader.astro";
import ProjectDetails from "@/components/projects/ProjectDetails.astro";
import MarkdownArticle from "@/components/markdown/MarkdownArticle.astro";
import { getProjectsStaticPaths, loadProject } from "@/services/projects";
import { loadUI } from "@/services/content";
import { getProjectReadmeHtml } from "@/services/github";

export async function getStaticPaths() {
  return getProjectsStaticPaths();
}

const { id, lang } = Astro.params;
if (!id || !lang) {
  throw new Error("Project ID and language must be provided");
}

const [project, ui] = await Promise.all([
  loadProject(id, lang),
  loadUI(lang),
]);

const readmeHtml = await getProjectReadmeHtml(project, lang);
---

<Layout title={project.title} description={project.description}>
  <BackButtonHeader label={ui.go_back} fallbackUrl={`/${lang}`} />
  <main class="w-full max-w-4xl mx-auto flex flex-col px-4 md:px-2 pt-10 pb-16">
    <ProjectDetails project={project} ui={ui} lang={lang} />
    <MarkdownArticle content={readmeHtml} />
  </main>
</Layout>